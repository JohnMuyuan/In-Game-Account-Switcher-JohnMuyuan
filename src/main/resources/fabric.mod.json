{
  "schemaVersion": 1,
  "id": "ias",
  "version": "${version}",
  "name": "In-Game Account Switcher: JohnMuyuan Edited Version",
  "description": "允许您在游戏中更改登入的帐号，而无需重新启动 Minecraft。此版本为江木源（JohnMuyuan）修改版，添加了多项功能并优化了账号切换体验。",
  "authors": [
    "VidTu",
    "JohnMuyuan"
  ],
  "contributors": [
    "The_Fireplace",
    "The_BrainStone",
    "2xsaiko",
    "Elvm",
    "Fhilips613",
    "WyattMarks"
  ],
  "contact": {
    "homepage": "https://github.com/JohnMuyuan/In-Game-Account-Switcher-JohnMuyuan",
    "issues": "https://github.com/JohnMuyuan/In-Game-Account-Switcher-JohnMuyuan/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "ias.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      //? if >=1.21.8 {
      "ru.vidtu.ias.platform.IFabric"
      //?} else {
      /*"ru.vidtu.ias.IASFabric"
      *///?}
    ],
    "modmenu": [
      //? if >=1.21.8 {
      "ru.vidtu.ias.platform.IModMenu"
      //?} else {
      /*"ru.vidtu.ias.IASModMenu"
      *///?}
    ]
  },
  "mixins": [
    {
      "config": "ias.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "${minecraft}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-resource-loader-${fabricResourceLoaderRevision}": "*",
    "fabric-screen-api-v1": "*"
  },
  "recommends": {
    "${fabricApiName}": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "ias.johnmuyuan.homepage": "https://github.com/JohnMuyuan/In-Game-Account-Switcher-JohnMuyuan"
      }
    },
    "catalogue": {
      "icon": {
        "image": "ias.png",
        "item": "player_head"
      },
      "banner": "ias.png"
    }
  }
}
